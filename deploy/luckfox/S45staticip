#!/bin/sh
#
# S45staticip - 给 SFS 服务端所在的 eth1 设固定地址
#
# 为什么不用 dhcpcd：dhcpcd 9.4.1 用 noprefixroute 添加地址、路由由它自己维护，
# 断开/重启时会出现"旧租约和静态地址同时挂着、默认路由缺失"的状态（实测过）。
# 这里用 ip(8) 显式配置，行为可预期；dhcpcd.conf 里对应有 denyinterfaces eth1。
#
# 注意：192.168.1.5 若落在路由器 DHCP 池内，仍可能与其它设备撞车，
# 建议同时在路由器上给本机 MAC(12:00:d0:eb:aa:50) 加一条 DHCP 保留。

IF=eth1
ADDR=192.168.1.5/24
IP=192.168.1.5
GW=192.168.1.1
METRIC=100

case "$1" in
  start)
    ip link set "$IF" up
    # 先清掉 dhcpcd 可能留下的同网段地址，避免出现两个源地址
    ip -4 addr show "$IF" | sed -n "s/.*inet \([0-9.]*\/[0-9]*\).*/\1/p" | while read a; do
      [ "$a" = "$ADDR" ] || ip addr del "$a" dev "$IF" 2>/dev/null
    done
    ip addr add "$ADDR" dev "$IF" 2>/dev/null
    ip route replace default via "$GW" dev "$IF" src "$IP" metric "$METRIC"
    echo "$(date "+%F %T") eth1 -> $ADDR gw $GW" >> /opt/sfs/init.log
    ;;
  stop)
    ip route del default via "$GW" dev "$IF" 2>/dev/null
    ip addr del "$ADDR" dev "$IF" 2>/dev/null
    ;;
esac
exit 0
