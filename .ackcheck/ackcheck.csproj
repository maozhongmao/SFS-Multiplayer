using System;
using System.IO;
using System.Text;
var hex = args[0];
var b = Convert.FromHexString(hex);
using var s = new MemoryStream(b, false);
using var r = new BinaryReader(s, Encoding.UTF8);
Console.WriteLine($"magic={r.ReadUInt32():X8} version={r.ReadInt32()} player={r.ReadInt32()}");
Console.WriteLine($"d={r.ReadDouble()},{r.ReadDouble()},{r.ReadDouble()},{r.ReadDouble()} diff={r.ReadByte()}");
for (int i=0;i<3;i++) { var n=r.ReadInt32(); var x=r.ReadBytes(n); Console.WriteLine($"s{i}={n} pos={s.Position}"); }
Console.WriteLine($"pos={s.Position} len={s.Length}");
