JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM* vm, void* res){
    (void)res;
    g_vm = vm;
    log_app("v29: JNI_OnLoad\n");
    pthread_t t;
    if(pthread_create(&t,NULL,worker,NULL)==0) pthread_detach(t);
    return JNI_VERSION_1_6;
}
