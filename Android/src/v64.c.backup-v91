/* v73: 完整结构上传 */
typedef struct { char name[48]; float x, y, ox, oy, oz, temp; } v73_part_rec;
typedef struct { int a, b; } v73_joint_rec;
typedef struct { int stage_id; int n; int ids[256]; } v73_stage_rec;
extern void mp_set_structure(const char* name, const v73_part_rec* parts, int nparts,
                             const v73_joint_rec* joints, int njoints,
                             const v73_stage_rec* stages, int nstages);
